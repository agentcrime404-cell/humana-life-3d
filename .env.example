ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]
# Bot Telegram per gli aggiornamenti
TELEGRAM_BOT_TOKEN=
# Admin dell'editor mappa (nomi giocatore / email, separati da virgola)
ADMIN_USERS=
ADMIN_EMAILS=
# Ricariche di prova senza soldi veri (non impostare online)
TEST_PAYMENTS=
