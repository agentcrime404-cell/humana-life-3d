PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/humana.sqlite
# Impostare l'origine HTTPS pubblica prima di esporre il server.
# PUBLIC_ORIGIN=https://humana.example.com
# Per reti diverse configurare TURN con credenziali temporanee in produzione.
ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]
# TLS_CERT=/percorso/fullchain.pem
# TLS_KEY=/percorso/privkey.pem

# Pagamenti Stripe (solo chiavi di TEST sk_test_...; le chiavi live sono rifiutate)
# STRIPE_SECRET_KEY=sk_test_...
# Facoltativo, per il webhook (stripe listen --forward-to localhost:3077/api/stripe/webhook)
# STRIPE_WEBHOOK_SECRET=whsec_...
