# Copia questo file in .env e compila. Il vero .env NON va su git.
PORT_3D=3079
HOST=0.0.0.0
DATABASE_PATH_3D=./data/humana-3d.sqlite
# Origine HTTPS pubblica (solo se esposto su internet): PUBLIC_ORIGIN=https://humana-life-3d.onrender.com
